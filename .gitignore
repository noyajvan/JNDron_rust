# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Secrets - never commit any of these. The repository has a public remote, so
# anything committed here is effectively published, and a value removed in a later
# commit still lives in the history.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
*_credentials*
*secret*
secrets/
mp_connect.*
*.local
