# sdkconfig.defaults for jndron-firmware (ESP32-S3-DevKitC-1, 4 MB flash)
#
# Mirrors firmware/platformio.ini:
#   board_upload.flash_size = 4MB
#   board_build.arduino.memory_type = dio_qspi
#   -DARDUINO_USB_CDC_ON_BOOT=1   -> USB Serial/JTAG console
#
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y

# USB Serial/JTAG console (the Rust firmware reads the console from it).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=n

# CPU: the C++ firmware dropped the clock to 80 MHz in setup().
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_80=y

# The IDF default of 3584 bytes is not enough for `main` here: `Platform`,
# `Bridge` and the 2 KiB bridge buffers in `pump_gcs`/`pump_fc` all live on this
# task's stack, and with the default the firmware reboots with
# "A stack overflow in task main has been detected" right after startup.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# Wi-Fi station only; WPA2 (WPA3-only is not supported by the ESP32 radio).
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
